#version 450
// =============================================================================
// terrain_compute.comp
// GPU Shadow Router — Minecraft terrain density field compute shader.
//
// Computes a 16 × Y_LEVELS × 16 density field for one chunk column.
// Density > 0 → solid block; density <= 0 → air.
//
// Mirrors the vanilla Overworld NoiseRouter / finalDensity evaluation.
// Loaded and concatenated by com.rhythmatician.lodiffusion.gpu.GlslShaderLoader:
//   [this file from #version to before "// --- INCLUDE CUT ---"]
//   + mc_improved_noise.glsl
//   + mc_perlin_noise.glsl
//   + mc_normal_noise.glsl
//   [this file from "// --- INCLUDE CUT ---" to end]
// =============================================================================

// One workgroup = one 16×16 chunk column.
// Thread (localX, localZ) handles all Y values for its block column.
layout(local_size_x = 16, local_size_y = 1, local_size_z = 16) in;

// ---------------------------------------------------------------------------
// Constants matching vanilla Overworld dimensions
// ---------------------------------------------------------------------------
#define Y_MIN       (-64)
#define Y_MAX       320
#define Y_LEVELS    384      // Y_MAX - Y_MIN
#define MAX_OCTAVES 16

// ---------------------------------------------------------------------------
// SSBOs — populated once at world load by NoiseRouterExtractor.java
// ---------------------------------------------------------------------------

// ImprovedNoise origin offsets: 4 floats per instance [xo, yo, zo, _pad]
layout(binding = 0, std430) buffer ImprovedOrigins {
    float data[];
} improved_origins;

// ImprovedNoise permutation tables: 256 uints per instance, flat
layout(binding = 1, std430) buffer ImprovedPerms {
    uint data[];
} improved_perms;

// PerlinNoise integer config (stride = PN_INT_STRIDE ints per instance):
//   [0]           : num_octaves
//   [1..3]        : _pad
//   [4 + octave]  : improved_noise_index  (-1 = null octave)
#define PN_INT_STRIDE   (4 + MAX_OCTAVES)
layout(binding = 2, std430) buffer PerlinInt {
    int data[];
} perlin_int;

// PerlinNoise float config (stride = PN_FLOAT_STRIDE floats per instance):
//   [0]           : lowestFreqInputFactor
//   [1]           : lowestFreqValueFactor
//   [2 + octave]  : amplitude[octave]
#define PN_FLOAT_STRIDE (2 + MAX_OCTAVES)
layout(binding = 3, std430) buffer PerlinFloat {
    float data[];
} perlin_float;

// NormalNoise integer config: 4 ints per instance
//   [0] : first_perlin_idx
//   [1] : second_perlin_idx
//   [2..3] : _pad
layout(binding = 4, std430) buffer NormalNoiseInt {
    int data[];
} normal_noise_int;

// NormalNoise float config: 1 float per instance
//   [0] : value_factor
layout(binding = 5, std430) buffer NormalNoiseFloat {
    float data[];
} normal_noise_float;

// Spline control point data (packed).
// Layout: [numPoints, x0, y0, x1, y1, ...] per spline, addressed by spline_offsets UBO.
// Used for TerrainProvider cubic splines (continents→offset, etc.).
layout(binding = 6, std430) buffer SplineData {
    float data[];
} spline_data;

// TerrainShaperMLP weights and biases (SSBO).
// Flattened layout:
//   [0..127]    = W1[32,4] row-major (input layer weights)
//   [128..159]  = b1[32] (input layer bias)
//   [160..1183] = W2[32,32] row-major (hidden layer weights)
//   [1184..1215] = b2[32] (hidden layer bias)
//   [1216..1248] = W3[3,32] row-major (output layer weights)
//   [1249..1251] = b3[3] (output layer bias)
layout(binding = 9, std430) buffer ShapeMlpWeights {
    float data[];
} shape_mlp_weights;

// TerrainShaperMLP configuration (UBO).
// Stores layer sizes and byte offsets into the weights SSBO.
layout(binding = 10, std140) uniform ShapeMlpConfig {
    int in_size;         // 4
    int hidden_size;     // 32
    int out_size;        // 3
    int _pad0;
    
    int w1_offset;       // 0
    int b1_offset;       // 128
    int w2_offset;       // 160
    int b2_offset;       // 1184
    int w3_offset;       // 1216
    int b3_offset;       // 1249
} shape_mlp_cfg;

// Output density field for the current chunk dispatch.
// Indexed: [localX + 16 * localZ] * Y_LEVELS + (blockY - Y_MIN)
// i.e., column-major XZ, then Y.
layout(binding = 7, std430) buffer DensityOutput {
    float data[];
} density_out;

// ---------------------------------------------------------------------------
// Uniform buffer: dimension-specific router configuration.
// Populated from the live NoiseRouter at world load.
// ---------------------------------------------------------------------------
layout(binding = 8, std140) uniform RouterConfig {
    // Chunk origin in block coords (set per dispatch via push constant or update)
    int chunk_origin_x;
    int chunk_origin_z;
    int _pad0;
    int _pad1;

    // NormalNoise indices for named router outputs
    int nn_continents;      // NoiseRouter.continents (horizontal shaping)
    int nn_erosion;         // NoiseRouter.erosion
    int nn_ridges;          // NoiseRouter.ridges (weirdness)
    int nn_depth_noise;     // The "sloped cheese" base noise for finalDensity
    int nn_jagged;          // Jaggedness noise (high-freq vertical shape)
    int nn_shift_a;         // X/Z coordinate shift noise
    int nn_shift_b;         // X/Z coordinate shift noise (Z component)
    int _pad2;

    // YClampedGradient parameters for the depth gradient
    // (from NoiseRouterData, varies slightly by worldgen preset)
    float grad_from_y;      // Overworld default: -64
    float grad_to_y;        // Overworld default:  320
    float grad_from_value;  // Overworld default:   1.5
    float grad_to_value;    // Overworld default:  -1.5

    // Spline table offsets (index into spline_data.data[] for each named spline)
    int spline_offset_offset;   // terrain offset spline
    int spline_factor_offset;   // terrain factor (vertical scale) spline
    int spline_jagged_offset;   // jaggedness modifier spline
    int _pad3;
} router;

// ---------------------------------------------------------------------------
// [mc_improved_noise.glsl CONCATENATED HERE by Java loader]
// [mc_perlin_noise.glsl   CONCATENATED HERE by Java loader]
// [mc_normal_noise.glsl   CONCATENATED HERE by Java loader]
// ---------------------------------------------------------------------------
// --- INCLUDE CUT ---

// ---------------------------------------------------------------------------
// Density graph helpers
// ---------------------------------------------------------------------------

// DensityFunctions.Mapped.Type.SQUEEZE
// Matches Java: x / 2 - x*x*x / 24
float mc_squeeze(float x) {
    return x / 2.0 - x * x * x / 24.0;
}

// DensityFunctions.Mapped.Type.HALF_NEGATIVE
float mc_half_negative(float x) {
    return x > 0.0 ? x : x * 0.5;
}

// DensityFunctions.Mapped.Type.QUARTER_NEGATIVE
float mc_quarter_negative(float x) {
    return x > 0.0 ? x : x * 0.25;
}

// ---------------------------------------------------------------------------
// TerrainShaperMLP evaluation
// Evaluates a 4->32->32->3 MLP that approximates the nested CubicSpline
// terrain shaper functions (offset, factor, jaggedness).
// ---------------------------------------------------------------------------
vec3 mc_terrain_shaper_mlp(vec4 input_vec) {
    // Extract input vector
    float input_data[4] = {input_vec.x, input_vec.y, input_vec.z, input_vec.w};
    
    // Layer 1: W1[32,4] @ input + b1[32] -> ReLU
    float hidden1[32];
    for (int i = 0; i < 32; i++) {
        float val = shape_mlp_weights.data[shape_mlp_cfg.b1_offset + i];  // Bias
        for (int j = 0; j < 4; j++) {
            int w_idx = shape_mlp_cfg.w1_offset + i * 4 + j;
            val += shape_mlp_weights.data[w_idx] * input_data[j];
        }
        hidden1[i] = max(0.0, val);  // ReLU
    }
    
    // Layer 2: W2[32,32] @ hidden1 + b2[32] -> ReLU
    float hidden2[32];
    for (int i = 0; i < 32; i++) {
        float val = shape_mlp_weights.data[shape_mlp_cfg.b2_offset + i];  // Bias
        for (int j = 0; j < 32; j++) {
            int w_idx = shape_mlp_cfg.w2_offset + i * 32 + j;
            val += shape_mlp_weights.data[w_idx] * hidden1[j];
        }
        hidden2[i] = max(0.0, val);  // ReLU
    }
    
    // Layer 3: W3[3,32] @ hidden2 + b3[3] -> Linear (no activation)
    vec3 output;
    for (int i = 0; i < 3; i++) {
        float val = shape_mlp_weights.data[shape_mlp_cfg.b3_offset + i];  // Bias
        for (int j = 0; j < 32; j++) {
            int w_idx = shape_mlp_cfg.w3_offset + i * 32 + j;
            val += shape_mlp_weights.data[w_idx] * hidden2[j];
        }
        output[i] = val;
    }
    
    return output;  // [offset, factor, jaggedness]
}

// DensityFunctions.YClampedGradient.compute():
// Mth.clampedMap(y, fromY, toY, fromValue, toValue)
float mc_y_gradient(float y, float from_y, float to_y, float from_val, float to_val) {
    return clamp(from_val + (y - from_y) * (to_val - from_val) / (to_y - from_y),
                 min(from_val, to_val), max(from_val, to_val));
}

// DensityFunctions.Spline cubic spline evaluation.
// Reads control points from spline_data starting at 'offset':
//   spline_data[offset]     = num_points (float, cast to int)
//   spline_data[offset+1+i] = location[i]
//   spline_data[offset+1+N+i] = value[i]
//   spline_data[offset+1+2N+i] = derivative[i]
// Uses Minecraft's CubicSpline evaluation (Catmull-Rom style with explicit derivatives).
float mc_spline_eval(int offset, float t) {
    int n = int(spline_data.data[offset]);
    if (n == 0) return 0.0;

    // Find the interval [i, i+1] that contains t
    int base = offset + 1;
    int i = 0;
    for (int k = 0; k < n - 1; k++) {
        if (spline_data.data[base + k] <= t) i = k;
    }

    // Clamp extrapolation
    float x0 = spline_data.data[base + i];
    float x1 = spline_data.data[base + i + 1];
    float y0 = spline_data.data[base + n + i];
    float y1 = spline_data.data[base + n + i + 1];
    float d0 = spline_data.data[base + 2 * n + i];
    float d1 = spline_data.data[base + 2 * n + i + 1];

    // Hermite cubic segment
    float dx = x1 - x0;
    if (abs(dx) < 1e-6) return y0;
    float u = clamp((t - x0) / dx, 0.0, 1.0);
    float u2 = u * u;
    float u3 = u2 * u;

    // Standard cubic Hermite: h00, h10, h01, h11 basis functions
    float h00 =  2.0*u3 - 3.0*u2 + 1.0;
    float h10 =      u3 - 2.0*u2 + u;
    float h01 = -2.0*u3 + 3.0*u2;
    float h11 =      u3 -     u2;

    return h00*y0 + h10*dx*d0 + h01*y1 + h11*dx*d1;
}

// ---------------------------------------------------------------------------
// finalDensity evaluation
// Mirrors the vanilla Overworld NoiseRouter.finalDensity density function graph.
// Now uses the TerrainShaperMLP for continents/erosion/ridges -> offset/factor/jaggedness
// mapping instead of the stubbed spline_eval calls.
//
//  IMPLEMENTATION STATUS:
//   [x] YClampedGradient (depth base)
//   [x] NormalNoise sampling (sloped_cheese, jaggedness)
//   [x] SQUEEZE, HALF_NEGATIVE, QUARTER_NEGATIVE
//   [x] TerrainShaperMLP (continents/erosion/ridges/weirdness shaping) ← REPLACED with MLP
//   [x] ShiftedNoise (XZ coordinate distortion via shift_a/shift_b)
//   [ ] WeirdScaledSampler (cave/ravine scaling)
//   [ ] RangeChoice (cave carver switching)
//   [ ] FindTopSurface (preliminary surface level Y search)
// ---------------------------------------------------------------------------
float computeFinalDensity(float bx, float by, float bz) {
    // -- Step 1: Compute XZ coordinate distortion (ShiftedNoise) ---------------
    // In vanilla all climate noises are ShiftedNoise2d — sampled at:
    //   (bx * 0.25 + shift_x,  0,  bz * 0.25 + shift_z)
    // Both shift_x and shift_z come from Noises.SHIFT (the same NormalNoise) evaluated
    // at permuted coordinates (ShiftA / ShiftB from DensityFunctions.java):
    //   shift_x = SHIFT.getValue(bx*0.25, 0,      bz*0.25) * 4.0  [ShiftA]
    //   shift_z = SHIFT.getValue(bz*0.25, bx*0.25, 0     ) * 4.0  [ShiftB — x/z swap]
    // nn_shift_a holds the SHIFT NormalNoise index (same index used for both permutations).
    // Guard: if not yet wired (WS-1.2), fall back to correct xzScale without shift.
    float sx, sz;
    if (router.nn_shift_a >= 0) {
        float shift_x = mc_normal_noise(router.nn_shift_a, bx * 0.25, 0.0,       bz * 0.25) * 4.0;
        float shift_z = mc_normal_noise(router.nn_shift_a, bz * 0.25, bx * 0.25, 0.0      ) * 4.0;
        sx = bx * 0.25 + shift_x;
        sz = bz * 0.25 + shift_z;
    } else {
        // Fallback: correct xzScale=0.25, no distortion (until WS-1.2 wires nn_shift_a)
        sx = bx * 0.25;
        sz = bz * 0.25;
    }

    // -- Step 2: Sample horizontal routing noises (2D at shifted/scaled XZ) ----
    // These drive the spline-based terrain shaping (continents, erosion, ridges, weirdness).
    //
    // In vanilla, NoiseRouter.ridges is the single noise source for both "weirdness"
    // and the folded "peaks and valleys" ridges value fed to the terrain shaper:
    //   weirdness     = ridges_noise (raw)          → TerrainShaper input 4
    //   ridges_folded = peaksAndValleys(weirdness)  → TerrainShaper input 3
    float continents = mc_normal_noise(router.nn_continents, sx, 0.0, sz);
    float erosion    = mc_normal_noise(router.nn_erosion,    sx, 0.0, sz);
    float weirdness  = mc_normal_noise(router.nn_ridges,     sx, 0.0, sz);

    // Vanilla "peaks and valleys" transform (NoiseRouterData.peaksAndValleys):
    //   peaksAndValleys(x) = 1 - |1 - |x + 0.5| * 2|   (approximately)
    // Folds the raw weirdness noise into a [~-1, ~0.5] range that peaks at ridges.
    float ridges_abs    = abs(weirdness) * 2.0 - 1.0;
    float ridges_folded = mc_half_negative(1.0 - abs(ridges_abs));

    // -- Step 3: TerrainShaperMLP evaluation -----------------------------------
    // The MLP replaces the nested cubic splines that map
    // (continents, erosion, ridges_folded, weirdness) -> (offset, factor, jaggedness)
    vec4 mlp_input = vec4(continents, erosion, ridges_folded, weirdness);
    vec3 mlp_output = mc_terrain_shaper_mlp(mlp_input);
    float terrain_offset = mlp_output.x;      // offset
    float terrain_factor = mlp_output.y;      // steepness factor
    float jaggedness_factor = mlp_output.z;   // jaggedness

    // -- Step 4: Y-based depth gradient ---------------------------------------
    // DensityFunctions.YClampedGradient — maps block Y to a depth value.
    // Overworld: y=−64 → +1.5, y=320 → −1.5 (surface near 0, underground positive)
    float depth_gradient = mc_y_gradient(by,
                                         router.grad_from_y,
                                         router.grad_to_y,
                                         router.grad_from_value,
                                         router.grad_to_value);

    float depth = depth_gradient + terrain_offset;

    // -- Step 5: 3D "sloped cheese" noise (large-scale vertical variation) -----
    // Corresponds to the interpolated noise sampled at (x, y, z) that forms the
    // base of the density field — what Mojang calls "slopedCheese" internally.
    float sloped_cheese = mc_normal_noise(router.nn_depth_noise, bx, by, bz);

    // -- Step 6: Jaggedness bias (high-frequency detail near surface) ----------
    // This adds sharp vertical variation near the surface (cliffs, overhangs).
    // In vanilla: jaggedness * heightNoise * mc_half_negative(jagged_noise)
    float jagged_noise = mc_normal_noise(router.nn_jagged, bx, by, bz);
    float jaggedness_applied = jaggedness_factor * mc_half_negative(jagged_noise);

    // -- Step 7: Combine into raw final density --------------------------------
    // Vanilla formula:
    //   initialDensity = 4.0 * mc_quarter_negative(factor * (depth + jaggedness))
    //   finalDensity = squeeze(initialDensity + slopedCheese)
    // This is now applied correctly with the factor term.
    float initial_density = 4.0 * mc_quarter_negative(terrain_factor * (depth + jaggedness_applied));
    float raw_density = initial_density + sloped_cheese;

    // Apply squeeze (DensityFunctions.Mapped SQUEEZE), then clamp to [-64, 64]
    return clamp(mc_squeeze(raw_density) * 64.0, -64.0, 64.0);
}

// ---------------------------------------------------------------------------
// Compute shader entry point
// ---------------------------------------------------------------------------
void main() {
    // Each thread handles one (localX, localZ) block column in the chunk.
    int localX = int(gl_LocalInvocationID.x);   // 0..15
    int localZ = int(gl_LocalInvocationID.z);   // 0..15

    // Absolute block coordinates for this column
    int blockX = router.chunk_origin_x + localX;
    int blockZ = router.chunk_origin_z + localZ;

    // Column index in the output array (XZ-major)
    int col     = localX + 16 * localZ;         // 0..255
    int col_off = col * Y_LEVELS;               // stride into density_out

    // Evaluate density for every Y level in the dimension
    for (int yi = 0; yi < Y_LEVELS; yi++) {
        int blockY = Y_MIN + yi;

        float density = computeFinalDensity(float(blockX), float(blockY), float(blockZ));

        density_out.data[col_off + yi] = density;
    }
}
